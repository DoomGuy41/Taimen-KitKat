From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DoomGuy41 <DoomGuy41@users.noreply.github.com>
Date: Fri, 16 Oct 2026 20:16:09 +0000
Subject: [PATCH] Time and alarms without /dev/alarm (timerfd, settimeofday,
 CAP_WAKE_ALARM)

The 4.4 kernel has no Android alarm driver. ART part: the zygote sets capabilities with the
version 3 (64-bit) capset ABI so system_server keeps CAP_WAKE_ALARM and CAP_BLOCK_SUSPEND.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/native/dalvik_system_Zygote.cc | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/runtime/native/dalvik_system_Zygote.cc b/runtime/native/dalvik_system_Zygote.cc
index 2acacc9..f5f4fa3 100644
--- a/runtime/native/dalvik_system_Zygote.cc
+++ b/runtime/native/dalvik_system_Zygote.cc
@@ -229,19 +229,22 @@ static void DropCapabilitiesBoundingSet() {
 }
 
 static void SetCapabilities(int64_t permitted, int64_t effective) {
+  // Pixel 2 XL: version 3 (64-bit) so system_server keeps CAP_WAKE_ALARM (35)
   __user_cap_header_struct capheader;
-  __user_cap_data_struct capdata;
+  __user_cap_data_struct capdata[2];
 
   memset(&capheader, 0, sizeof(capheader));
   memset(&capdata, 0, sizeof(capdata));
 
-  capheader.version = _LINUX_CAPABILITY_VERSION;
+  capheader.version = _LINUX_CAPABILITY_VERSION_3;
   capheader.pid = 0;
 
-  capdata.effective = effective;
-  capdata.permitted = permitted;
+  capdata[0].effective = static_cast<uint32_t>(effective);
+  capdata[0].permitted = static_cast<uint32_t>(permitted);
+  capdata[1].effective = static_cast<uint32_t>(effective >> 32);
+  capdata[1].permitted = static_cast<uint32_t>(permitted >> 32);
 
-  if (capset(&capheader, &capdata) != 0) {
+  if (capset(&capheader, &capdata[0]) != 0) {
     PLOG(FATAL) << "capset(" << permitted << ", " << effective << ") failed";
   }
 }
