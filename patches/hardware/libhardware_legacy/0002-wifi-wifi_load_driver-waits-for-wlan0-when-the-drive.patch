From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DoomGuy41 <DoomGuy41@users.noreply.github.com>
Date: Thu, 15 Oct 2026 22:54:55 +0000
Subject: [PATCH 2/2] wifi: wifi_load_driver waits for wlan0 when the driver is
 loaded outside the HAL

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 wifi/wifi.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/wifi/wifi.c b/wifi/wifi.c
index ff9357b..8f6396a 100644
--- a/wifi/wifi.c
+++ b/wifi/wifi.c
@@ -245,6 +245,18 @@ int wifi_load_driver()
     wifi_unload_driver();
     return -1;
 #else
+    /* Pixel 2 XL: the driver is loaded outside the HAL (wifi firmware in the modem, ready a few
+     * seconds after boot): wait for the interface before starting the supplicant */
+    {
+        int i;
+        for (i = 0; i < 300 && access("/sys/class/net/wlan0", F_OK) != 0; i++)
+            usleep(100000);
+        if (i == 300) {
+            ALOGE("no wlan0 after 30 s");
+            property_set(DRIVER_PROP_NAME, "timeout");
+            return -1;
+        }
+    }
     property_set(DRIVER_PROP_NAME, "ok");
     return 0;
 #endif
