Subject: [PATCH 1/8] rootdir: servicemanager not critical (bring-up)

---
 rootdir/init.rc | 1 -
 1 file changed, 1 deletion(-)

diff --git a/rootdir/init.rc b/rootdir/init.rc
index 1ee9fbf..4cf2a65 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -460,7 +460,6 @@ service servicemanager /system/bin/servicemanager
