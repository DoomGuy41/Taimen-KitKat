     fd = open("/dev/alarm", O_RDWR);
     if(fd < 0) {
-        ALOGW("Unable to open alarm driver: %s\n", strerror(errno));
-        return -1;
+        // Pixel 2 XL: no /dev/alarm on the 4.4 kernel; settimeofday (CAP_SYS_TIME of
+        // system_server). The PM8998 RTC refuses writes: the offset between wall time and
+        // the RTC is saved, and init.taimen.rc applies it again at boot.
+        if (settimeofday(&tv, NULL) < 0) {
+            ALOGW("Unable to set time of day to %ld: %s\n", tv.tv_sec, strerror(errno));
+            return -1;
+        }
+        long long rtc = -1;
+        FILE *f = fopen("/sys/class/rtc/rtc0/since_epoch", "r");
+        if (f) {
+            if (fscanf(f, "%lld", &rtc) != 1)
+                rtc = -1;
+            fclose(f);
+        }
+        if (rtc >= 0) {
+            mkdir("/data/system/time", 0770);
+            f = fopen("/data/system/time/rtc_offset.tmp", "w");
+            if (f) {
+                fprintf(f, "%lld\n", (long long)tv.tv_sec - rtc);
+                fclose(f);
+                rename("/data/system/time/rtc_offset.tmp", "/data/system/time/rtc_offset");
+            }
+        }
+        return 0;
     }
     ts.tv_sec = tv.tv_sec;
     ts.tv_nsec = tv.tv_usec * 1000;
diff --git a/services/jni/com_android_server_AlarmManagerService.cpp b/services/jni/com_android_server_AlarmManagerService.cpp
