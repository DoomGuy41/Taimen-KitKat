+// Pixel 2 XL: the 4.4 kernel no longer has the /dev/alarm driver. Alarms use one timerfd per
+// type (*_ALARM clocks for the "wakeup" types, which wake the phone from suspend), gathered
+// in an epoll, like Lollipop's AlarmManagerService. The Java interface is unchanged:
+// init() returns the epoll descriptor, waitForAlarm() the mask of expired types, with bit 16
+// set when the wall time was changed (timerfd armed with TFD_TIMER_CANCEL_ON_SET).
+#ifndef CLOCK_BOOTTIME
+#define CLOCK_BOOTTIME 7
+#endif
+#ifndef CLOCK_REALTIME_ALARM
+#define CLOCK_REALTIME_ALARM 8
+#endif
+#ifndef CLOCK_BOOTTIME_ALARM
+#define CLOCK_BOOTTIME_ALARM 9
+#endif
+#ifndef TFD_TIMER_CANCEL_ON_SET
+#define TFD_TIMER_CANCEL_ON_SET (1 << 1)
+#endif
+
+// RTC_WAKEUP, RTC, ELAPSED_REALTIME_WAKEUP, ELAPSED_REALTIME
+static const clockid_t kAlarmClocks[] = {
+    CLOCK_REALTIME_ALARM, CLOCK_REALTIME, CLOCK_BOOTTIME_ALARM, CLOCK_BOOTTIME,
+};
+static const int kNumAlarms = sizeof(kAlarmClocks) / sizeof(kAlarmClocks[0]);
+static const int kTimeChangeBit = 16;
+static int sTimerFds[kNumAlarms + 1] = { -1, -1, -1, -1, -1 };  // last one: time change
+
+static int armTimeChangeTimer()
+{
+    // Far deadline on CLOCK_REALTIME: only the cancellation (ECANCELED) matters
+    struct itimerspec spec;
+    memset(&spec, 0, sizeof(spec));
+    spec.it_value.tv_sec = 0x7fffffff;
+    return timerfd_settime(sTimerFds[kNumAlarms], TFD_TIMER_ABSTIME | TFD_TIMER_CANCEL_ON_SET,
+                           &spec, NULL);
+}
+
 static jint android_server_AlarmManagerService_init(JNIEnv* env, jobject obj)
 {
-    return open("/dev/alarm", O_RDWR);
+    int epollfd = epoll_create(kNumAlarms + 1);
+    if (epollfd < 0) {
+        ALOGE("epoll_create: %s", strerror(errno));
+        return -1;
+    }
+    for (int i = 0; i <= kNumAlarms; i++) {
+        clockid_t clock = i < kNumAlarms ? kAlarmClocks[i] : CLOCK_REALTIME;
+        int fd = timerfd_create(clock, 0);
+        if (fd < 0 && i < kNumAlarms && (clock == CLOCK_REALTIME_ALARM || clock == CLOCK_BOOTTIME_ALARM)) {
+            // without CAP_WAKE_ALARM: non-wakeup alarms rather than no alarms at all
+            ALOGE("timerfd_create(%d): %s, falling back to non-wakeup", clock, strerror(errno));
+            fd = timerfd_create(clock == CLOCK_REALTIME_ALARM ? CLOCK_REALTIME : CLOCK_BOOTTIME, 0);
+        }
+        if (fd < 0) {
+            ALOGE("timerfd_create(%d): %s", clock, strerror(errno));
+            for (int j = 0; j < i; j++)
+                close(sTimerFds[j]);
+            close(epollfd);
+            return -1;
+        }
+        sTimerFds[i] = fd;
+        struct epoll_event event;
+        memset(&event, 0, sizeof(event));
+        event.events = EPOLLIN | EPOLLWAKEUP;
+        event.data.u32 = i;
+        if (epoll_ctl(epollfd, EPOLL_CTL_ADD, fd, &event) < 0) {
+            // EPOLLWAKEUP needs CAP_BLOCK_SUSPEND: retry without it
+            event.events = EPOLLIN;
+            if (epoll_ctl(epollfd, EPOLL_CTL_ADD, fd, &event) < 0)
+                ALOGE("epoll_ctl: %s", strerror(errno));
+        }
+    }
+    if (armTimeChangeTimer() < 0)
+        ALOGE("time change timerfd: %s", strerror(errno));
+    return epollfd;
 }
 
 static void android_server_AlarmManagerService_close(JNIEnv* env, jobject obj, jint fd)
 {
-	close(fd);
+    for (int i = 0; i <= kNumAlarms; i++) {
+        if (sTimerFds[i] >= 0)
+            close(sTimerFds[i]);
+        sTimerFds[i] = -1;
+    }
+    close(fd);
 }
 
 static void android_server_AlarmManagerService_set(JNIEnv* env, jobject obj, jint fd, jint type, jlong seconds, jlong nanoseconds)
 {
-    struct timespec ts;
-    ts.tv_sec = seconds;
-    ts.tv_nsec = nanoseconds;
-
-	int result = ioctl(fd, ANDROID_ALARM_SET(type), &ts);
-	if (result < 0)
-	{
+    if (type < 0 || type >= kNumAlarms)
+        return;
+    struct itimerspec spec;
+    memset(&spec, 0, sizeof(spec));
+    spec.it_value.tv_sec = seconds;
+    spec.it_value.tv_nsec = nanoseconds;
+    // a zero deadline would disarm the timerfd: bring it to 1 ns
+    if (spec.it_value.tv_sec == 0 && spec.it_value.tv_nsec == 0)
+        spec.it_value.tv_nsec = 1;
+    if (timerfd_settime(sTimerFds[type], TFD_TIMER_ABSTIME, &spec, NULL) < 0)
         ALOGE("Unable to set alarm to %lld.%09lld: %s\n", seconds, nanoseconds, strerror(errno));
-    }
 }
 
 static jint android_server_AlarmManagerService_waitForAlarm(JNIEnv* env, jobject obj, jint fd)
 {
-	int result = 0;
-
-	do
-	{
-		result = ioctl(fd, ANDROID_ALARM_WAIT);
-	} while (result < 0 && errno == EINTR);
-
-	if (result < 0)
-	{
+    struct epoll_event events[kNumAlarms + 1];
+    int n;
+    do {
+        n = epoll_wait(fd, events, kNumAlarms + 1, -1);
+    } while (n < 0 && errno == EINTR);
+    if (n < 0) {
         ALOGE("Unable to wait on alarm: %s\n", strerror(errno));
         return 0;
     }
 
+    int result = 0;
+    for (int i = 0; i < n; i++) {
+        int alarm = events[i].data.u32;
+        uint64_t expirations;
+        ssize_t r = read(sTimerFds[alarm], &expirations, sizeof(expirations));
+        if (alarm == kNumAlarms) {
+            if (r < 0 && errno == ECANCELED) {
+                result |= 1 << kTimeChangeBit;
+                armTimeChangeTimer();
+            }
+            continue;
+        }
+        if (r < 0 && errno == ECANCELED) {
+            result |= 1 << kTimeChangeBit;
+            continue;
+        }
+        if (r == sizeof(expirations))
+            result |= 1 << alarm;
+    }
     return result;
 }
 
