From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DoomGuy41 <DoomGuy41@users.noreply.github.com>
Date: Wed, 14 Oct 2026 20:48:25 +0000
Subject: [PATCH 1/2] idl_serializer: accept JSON::PP booleans (Perl >= 5.36)

---
 Source/bindings/scripts/idl_serializer.pm | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Source/bindings/scripts/idl_serializer.pm b/Source/bindings/scripts/idl_serializer.pm
index 0a6fdae..abc7ae1 100644
--- a/Source/bindings/scripts/idl_serializer.pm
+++ b/Source/bindings/scripts/idl_serializer.pm
@@ -86,6 +86,9 @@ sub jsonToPerl
         return $hashRef;
     }
 
+    # recent JSON::PP returns booleans as objects (JSON::PP::Boolean)
+    return($jsonData ? 1 : 0) if ref($jsonData) =~ /Boolean/;
+
     die "Unexpected reference type: " . ref $jsonData . "\n" if ref $jsonData;
 
     return $jsonData;
