# KitKat EGL/GLES shims in front of the Android 11 Adreno driver (libhyb)
# gles*_stubs.S and *_names.c: generated by gen_stubs.py (entries.in x Adreno exports)
LOCAL_PATH := $(call my-dir)

include $(CLEAR_VARS)
LOCAL_MODULE := libEGL_adreno
LOCAL_MODULE_PATH := $(TARGET_OUT_SHARED_LIBRARIES)/egl
LOCAL_MODULE_TAGS := optional
LOCAL_SRC_FILES := egl_shim.c
LOCAL_CFLAGS := -std=gnu99 -O2 -Wall -Wno-unused-parameter -DEGL_EGLEXT_PROTOTYPES
LOCAL_SHARED_LIBRARIES := libhyb libcutils liblog libdl
include $(BUILD_SHARED_LIBRARY)

include $(CLEAR_VARS)
LOCAL_MODULE := libGLESv2_adreno
LOCAL_MODULE_PATH := $(TARGET_OUT_SHARED_LIBRARIES)/egl
LOCAL_MODULE_TAGS := optional
LOCAL_SRC_FILES := gles_shim.c gles2_stubs.S gles2_stubs_names.c
LOCAL_CFLAGS := -std=gnu99 -O2 -Wall
LOCAL_SHARED_LIBRARIES := libhyb libcutils liblog
include $(BUILD_SHARED_LIBRARY)

include $(CLEAR_VARS)
LOCAL_MODULE := libGLESv1_CM_adreno
LOCAL_MODULE_PATH := $(TARGET_OUT_SHARED_LIBRARIES)/egl
LOCAL_MODULE_TAGS := optional
LOCAL_SRC_FILES := gles_shim.c gles1_stubs.S gles1_stubs_names.c
LOCAL_CFLAGS := -std=gnu99 -O2 -Wall -DSHIM_GLES1
LOCAL_SHARED_LIBRARIES := libhyb libcutils liblog
include $(BUILD_SHARED_LIBRARY)
