import init.taimen.usb.rc

on init
    mkdir /persist 0771 system system
    # Emulated storage (Nexus 5 configuration): without EXTERNAL_STORAGE, zygote
    # crashes in the android.os.Debug initializer (NullPointerException)
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /storage/emulated 0555 root root
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0
    symlink /mnt/shell/emulated/0 /storage/emulated/legacy

on post-fs
    # logs of the Android 11 daemons (logdw socket) copied to /dev/kmsg
    mkdir /dev/socket 0755 root root
    start logdw
    # ADSP (audio DSP): firmware in /system/vendor/firmware, the sound card shows up afterwards
    write /sys/kernel/boot_adsp/boot 1

on post-fs-data
    # KitKat NFC stack (NfcNci): state and parameters
    mkdir /data/nfc 0770 nfc nfc
    mkdir /data/nfc/param 0770 nfc nfc
    # Time: the PM8998 RTC is read-only; system_server saves the offset between wall
    # time and the RTC in /data/system/time/rtc_offset (android_os_SystemClock.cpp)
    start rtc-restore
    # wifi
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/dhcp 0770 dhcp dhcp
    chown dhcp dhcp /data/misc/dhcp
    # modem + wifi: chroot of the Android 11 Qualcomm daemons
    start v11-setup
    mkdir /data/media 0770 media_rw media_rw

on early-init
    mount debugfs debugfs /sys/kernel/debug
    mount pstore pstore /sys/fs/pstore

on fs
    mount_all ./fstab.taimen
    # No cache partition on the Pixel 2 (A/B): /cache in RAM
    mount tmpfs tmpfs /cache mode=0770,uid=1000,gid=2001

on boot
    start thermal-compat
    # Touch screen (LG sw49408 or ftm4 panel) and battery: stock kernel modules
    insmod /system/lib/modules/touch_core_base.ko
    insmod /system/lib/modules/ftm4.ko
    insmod /system/lib/modules/sw49408.ko
    insmod /system/lib/modules/lge_battery.ko
    # Vibrator (DRV2624 exposed as a LED): transient trigger = duration + activate
    write /sys/class/leds/vibrator/trigger transient
    write /sys/class/leds/vibrator/state 1
    chown system system /sys/class/leds/vibrator/activate
    chown system system /sys/class/leds/vibrator/duration
    chown system system /sys/class/leds/vibrator/state
    # lights HAL: backlight and notification LED
    chown system system /sys/class/leds/lcd-backlight/brightness
    chown system system /sys/class/leds/red/brightness
    chown system system /sys/class/leds/green/brightness
    chown system system /sys/class/leds/blue/brightness
    chown system system /sys/class/leds/red/on_off_ms
    chown system system /sys/class/leds/green/on_off_ms
    chown system system /sys/class/leds/blue/on_off_ms
    chown system system /sys/class/leds/red/rgb_start
    chown system system /sys/class/leds/green/rgb_start
    chown system system /sys/class/leds/blue/rgb_start
    # flash/torch (TaimenDiag app, system uid)
    chown system system /sys/class/leds/led:torch_0/brightness
    chown system system /sys/class/leds/led:torch_1/brightness
    chown system system /sys/class/leds/led:switch_0/brightness
    chown system system /sys/class/leds/led:switch_1/brightness
    chown system system /sys/class/leds/torch-light0/brightness
    chown system system /sys/class/leds/torch-light1/brightness
    chmod 0660 /sys/class/leds/vibrator/activate
    chmod 0660 /sys/class/leds/vibrator/duration

service blackbox /sbin/busybox sh /blackbox.sh
    class core
    user root
    oneshot
    disabled

# Virtual SD card (FUSE) on top of /data/media, as on the Nexus 5
service sdcard /system/bin/sdcard -u 1023 -g 1023 -l /data/media /mnt/shell/emulated
    class late_start

# Persistent log in /data/log (read after a crash)
service kmsglog /sbin/busybox sh /sbin/kmsglog.sh
    class core
    user root
    disabled

service logdw /sbin/logdw
    class core
    user root
    disabled

service v11-setup /sbin/busybox sh /sbin/v11.sh
    class core
    user root
    disabled
    oneshot

on property:sys.v11.ready=1
    start v11-pdmapper
    start v11-rmt
    start v11-tftp
    start v11-cnss
    start v11-sensors
    start v11-gnss
    start v11-nfc

service v11-nfc /sbin/busybox sh /sbin/v11-nfc.sh
    class core
    user root
    disabled

service v11-gnss /sbin/busybox sh /sbin/v11-gnss.sh
    class core
    user root
    disabled

service v11-sensors /sbin/busybox sh /sbin/v11-sensors.sh
    class core
    user root
    disabled
    oneshot

service v11-pdmapper /system/v11/hwchroot /system/v11/root /vendor/bin/pd-mapper
    class core
    user root
    disabled

service v11-rmt /system/v11/hwchroot /system/v11/root /vendor/bin/rmt_storage
    class core
    user root
    disabled

service v11-tftp /system/v11/hwchroot /system/v11/root /vendor/bin/tftp_server
    class core
    user root
    disabled

service v11-cnss /system/v11/hwchroot /system/v11/root /vendor/bin/cnss-daemon -n -l
    class core
    user root
    disabled

service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets \
    -e/data/misc/wifi/entropy.bin -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

service dhcpcd_wlan0 /system/bin/dhcpcd -aABDKL
    class main
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    disabled
    oneshot

service rtc-restore /sbin/busybox sh /sbin/rtc-restore.sh
    class core
    user root
    oneshot
    disabled

service thermal-compat /sbin/busybox sh /sbin/thermal-compat.sh
    class core
    user root
    oneshot
    disabled

# Boot completed: tell the bootloader (otherwise every boot uses up a retry and it eventually
# switches to the other slot)
on property:sys.boot_completed=1
    start v11-bootmark

service v11-bootmark /system/v11/hwchroot /system/v11/root /vendor/bin/bootmark
    class core
    user root
    oneshot
    disabled

# zero-copy presentation of SurfaceFlinger frames (MDSS atomic commit, 64-bit process)
service fbpresentd /system/bin/fbpresentd
    class core
    user system
    group graphics

# bring-up tools, not in user builds: verbose kernel log, black box (dmesg copied every 2 s, see
# blackbox.sh) and persistent log in /data/log
on property:ro.debuggable=1
    loglevel 8
    start blackbox
    start kmsglog
